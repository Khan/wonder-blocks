{
  "projectId": "e9e1c66b-5427-486a-a468-5d90bc569ba9",
  "shape": "storybook",
  "pkg": "@khanacademy/wonder-blocks-core",
  "globalName": "WonderBlocks",
  "storybookStatic": ".design-sync/sb-reference",
  "storybookConfigDir": ".storybook",
  "buildCmd": "pnpm build",
  "readmeHeader": ".design-sync/conventions.md",
  "entry": "./packages/wonder-blocks-core/dist/es/index.js",
  "tokensPkg": "@khanacademy/wonder-blocks-tokens",
  "extraFonts": ["../../static/jakarta.css", "../../static/lato.css"],
  "provider": {"component": "ThemeSwitcher", "props": {"theme": "thunderblocks"}},
  "libOverrides": {
    "source-storybook.mjs": "filter storybook entries to WB manifest-tagged canonical stories (drops Testing/Snapshots/Playtesting noise)",
    "story-imports.mjs": "map each WB package's default export (import Button from '@khanacademy/wonder-blocks-button') to its component name on the global"
  },
  "titleMap": {
    "BodyText(New)": "BodyText",
    "Heading(New)": "Heading"
  },
  "overrides": {
    "Accordion": {"cardMode": "column"},
    "AccordionSection": {"cardMode": "column"},
    "Badge": {"cardMode": "column"},
    "ModalDialog": {"cardMode": "column"},
    "ActivityButton": {"cardMode": "column"},
    "CompactCell": {"cardMode": "column"},
    "DetailCell": {"cardMode": "column"},
    "Listbox": {"cardMode": "column"},
    "Checkbox": {"cardMode": "column"},
    "CheckboxGroup": {"cardMode": "column"},
    "RadioGroup": {"cardMode": "column"},
    "Icon": {"cardMode": "column"},
    "PhosphorIcon": {"cardMode": "column"},
    "ActivityIconButton": {"cardMode": "column"},
    "OnePaneDialog": {"cardMode": "column"},
    "Card": {"cardMode": "column"},
    "Link": {"cardMode": "column"},
    "CircularSpinner": {"cardMode": "column"},
    "BodyText": {"cardMode": "column"},
    "Heading": {"cardMode": "column"},
    "Button": {"cardMode": "column"},
    "DrawerDialog": {"cardMode": "column"},
    "DrawerLauncher": {"cardMode": "column"},
    "ModalLauncher": {"cardMode": "column"},
    "BirthdayPicker": {"cardMode": "column"},
    "Toolbar": {"cardMode": "column"},
    "ResponsiveNavigationTabs": {"cardMode": "column"},
    "ResponsiveTabs": {"cardMode": "column"},
    "ThemeSwitcher": {"cardMode": "column"},
    "DatePicker": {"cardMode": "single"},
    "Combobox": {"cardMode": "single", "primaryStory": "Default"},
    "MultiSelect": {"cardMode": "single", "primaryStory": "Default"},
    "SingleSelect": {"cardMode": "single", "primaryStory": "Default"},
    "Popover": {"cardMode": "single"},
    "Tooltip": {"cardMode": "single", "skip": ["packages-tooltip-tooltip--in-top-corner"]},
    "Tabs": {"cardMode": "single"},
    "NavigationTabs": {"cardMode": "single"},
    "FlexibleDialog": {"cardMode": "column"},
    "ActionMenu": {"cardMode": "single"}
  },
  "extraEntries": [
    "../../.design-sync/bundle-entry.mjs",
    "@khanacademy/wonder-blocks-accordion",
    "@khanacademy/wonder-blocks-announcer",
    "@khanacademy/wonder-blocks-badge",
    "@khanacademy/wonder-blocks-banner",
    "@khanacademy/wonder-blocks-birthday-picker",
    "@khanacademy/wonder-blocks-breadcrumbs",
    "@khanacademy/wonder-blocks-button",
    "@khanacademy/wonder-blocks-card",
    "@khanacademy/wonder-blocks-cell",
    "@khanacademy/wonder-blocks-clickable",
    "@khanacademy/wonder-blocks-data",
    "@khanacademy/wonder-blocks-date-picker",
    "@khanacademy/wonder-blocks-dropdown",
    "@khanacademy/wonder-blocks-form",
    "@khanacademy/wonder-blocks-grid",
    "@khanacademy/wonder-blocks-icon",
    "@khanacademy/wonder-blocks-icon-button",
    "@khanacademy/wonder-blocks-labeled-field",
    "@khanacademy/wonder-blocks-layout",
    "@khanacademy/wonder-blocks-link",
    "@khanacademy/wonder-blocks-modal",
    "@khanacademy/wonder-blocks-popover",
    "@khanacademy/wonder-blocks-progress-spinner",
    "@khanacademy/wonder-blocks-search-field",
    "@khanacademy/wonder-blocks-styles",
    "@khanacademy/wonder-blocks-switch",
    "@khanacademy/wonder-blocks-tabs",
    "@khanacademy/wonder-blocks-theming",
    "@khanacademy/wonder-blocks-timing",
    "@khanacademy/wonder-blocks-tokens",
    "@khanacademy/wonder-blocks-toolbar",
    "@khanacademy/wonder-blocks-tooltip",
    "@khanacademy/wonder-blocks-typography"
  ]
}
