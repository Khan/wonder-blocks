{
  "name": "@khanacademy/stylelint-plugin-wonder-blocks",
  "description": "Stylelint plugin for the Wonder Blocks design system",
  "author": "Khan Academy",
  "license": "MIT",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Khan/wonder-blocks.git",
    "directory": "packages/stylelint-plugin-wonder-blocks"
  },
  "bugs": {
    "url": "https://github.com/Khan/wonder-blocks/issues"
  },
  "main": "dist/index.js",
  "module": "dist/es/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/es/index.js",
      "require": "./dist/index.js"
    },
    "./recommended": {
      "types": "./dist/configs/recommended.d.ts",
      "source": "./src/configs/recommended.ts",
      "node": "./dist/configs/recommended.js",
      "import": "./dist/es/configs/recommended.js",
      "require": "./dist/configs/recommended.js"
    },
    "./strict": {
      "types": "./dist/configs/strict.d.ts",
      "source": "./src/configs/strict.ts",
      "node": "./dist/configs/strict.js",
      "import": "./dist/es/configs/strict.js",
      "require": "./dist/configs/strict.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "../../utils/publish/package-pre-publish-check.sh"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "stylelint": "^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@khanacademy/wb-dev-build-settings": "workspace:*",
    "postcss": "^8.5.14",
    "stylelint": "^17.12.0"
  }
}
