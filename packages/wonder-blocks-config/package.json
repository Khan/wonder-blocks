{
    "name": "@khanacademy/wonder-blocks-config",
    "description": "Configuration for Wonder Blocks",
    "author": "Khan Academy",
    "license": "MIT",
    "version": "0.1.0",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Khan/wonder-blocks.git"
    },
    "bugs": {
        "url": "https://github.com/Khan/wonder-blocks/issues"
    },
    "main": "dist/index.js",
    "module": "dist/es/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "import": "./dist/es/index.js",
            "require": "./dist/index.js"
        },
        "./strings": {
            "types": "./dist/strings.d.ts",
            "source": "./src/strings.ts",
            "import": "./dist/es/strings.js",
            "require": "./dist/strings.js"
        }
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "prepublishOnly": "../../utils/publish/package-pre-publish-check.sh"
    },
    "peerDependencies": {
        "react": "catalog:"
    },
    "devDependencies": {
        "@khanacademy/wb-dev-build-settings": "workspace:*"
    }
}
